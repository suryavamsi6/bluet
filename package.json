{
  "name": "bluet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot app.tsx",
    "start": "bun app.tsx",
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:native": "bun scripts/native-smoke.ts",
    "test:dbus": "dbus-run-session -- sh -c 'DBUS_SYSTEM_BUS_ADDRESS=\"$DBUS_SESSION_BUS_ADDRESS\" bun scripts/dbus-integration.ts'",
    "package:arch": "bun scripts/package-arch.ts"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "dbus-next": "0.10.2",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0"
  }
}
